# ─── LOCAL STACK (default, no API keys needed) ───────────────────────────────
STT_PROVIDER=whisper          # whisper | deepgram | assemblyai
TTS_PROVIDER=local            # local | kokoro | edge | elevenlabs | openai
LLM_PROVIDER=ollama           # ollama | anthropic | openai

# ─── OLLAMA (local LLM) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2         # or mistral, qwen2.5, gemma2 etc.
LLM_TEMPERATURE=0.75
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.1
LLM_NUM_PREDICT=600
LLM_MAX_TOKENS=1024
LLM_MAX_HISTORY_TOKENS=2400   # hard cap on conversation history tokens sent to LLM

# ─── WHISPER (local STT) ─────────────────────────────────────────────────────
WHISPER_MODEL=base            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu            # cpu | cuda
WHISPER_COMPUTE=int8          # int8 (cpu) | float16 (gpu)
WHISPER_BEAM_SIZE=5           # trade accuracy for speed (lower = faster)
WHISPER_CONCURRENCY=1         # max concurrent transcriptions
WHISPER_MAX_AUDIO_BYTES=26214400  # 25MB max upload size

# ─── TTS SERVICE (Piper + Kokoro + edge-tts) ─────────────────────────────────
TTS_ENGINE=piper              # piper | kokoro | edge (used by TTS service internally)
TTS_SPEED=1.0
TTS_CONCURRENCY=1             # max concurrent syntheses

# ─── CLOUD PROVIDERS (upgrade path) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
HOST_BIND=127.0.0.1           # bind address (127.0.0.1 = localhost only)
NODE_ENV=development
ENABLE_COMPRESSION=true

# ─── UPSTREAM TIMEOUTS (ms) ──────────────────────────────────────────────────
LLM_TIMEOUT_MS=120000
STT_TIMEOUT_MS=60000
TTS_TIMEOUT_MS=60000

# ─── SESSIONS ────────────────────────────────────────────────────────────────
SESSION_MAX_HISTORY=20        # max turns in history (count-based ceiling)
SESSION_TTL_MS=7200000        # 2h session TTL
SESSION_CLEANUP_MS=1800000    # 30min cleanup interval
MAX_SESSIONS=25               # max concurrent sessions (memory DoS guard)
SESSION_PERSIST_DIR=/app/data/sessions  # empty = disabled, path = enable file persistence

# ─── AUDIO CACHE ─────────────────────────────────────────────────────────────
AUDIO_CACHE_DIR=/app/data/audio-cache
AUDIO_CACHE_MAX_BYTES=536870912  # 512MB max cache size

# ─── NETWORK / SECURITY ──────────────────────────────────────────────────────
CORS_ORIGINS=                 # comma-separated allowed origins; empty = same-origin only
AUTH_TOKEN=                   # optional Bearer token for all /api requests; empty = disabled